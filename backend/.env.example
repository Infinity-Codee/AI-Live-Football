APP_NAME=LiveFootballAIDetection
DEBUG=true

# Local dev uses an async SQLite file (works with `uvicorn app.main:app`).
# For the docker-compose Postgres stack, this is overridden automatically.
DATABASE_URL=sqlite+aiosqlite:///./footai.db

# ── Real data (optional) ────────────────────────────────────────────────
# Leave these as-is to run in DEMO mode (sample data, no network calls).
# Get a FREE API-Football key (100 requests/day, no card) at:
#   https://dashboard.api-football.com/register   →  Account → My Access
# Paste it below to switch the app to LIVE real scores automatically.
API_FOOTBALL_KEY=YOUR_API_FOOTBALL_KEY_HERE

# Optional: live betting odds. Free tier at https://the-odds-api.com
ODDS_API_KEY=YOUR_ODDS_API_KEY_HERE
